rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Books collection rules: anyone can read, only structural/validated edits
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.resource.data.title is string && request.resource.data.author is string;
    }

    // Members/users directory rules: anyone can read/write for self signups, but secure key types
    match /members/{memberId} {
      allow read: if true;
      allow write: if request.resource.data.name is string && request.resource.data.email is string;
    }

    // Donors/partners details
    match /donors/{donorId} {
      allow read: if true;
      allow write: if request.resource.data.name is string;
    }

    // Issued book records
    match /issues/{issueId} {
      allow read, write: if true;
    }

    // Finances logs
    match /finances/{transactionId} {
      allow read, write: if true;
    }

    // Department events
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.resource.data.title is string;
    }

    // Orders checkout details
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Website graphics settings
    match /graphics/{graphicId} {
      allow read: if true;
      allow write: if request.resource.data.homeHeroBg is string || request.resource.data.backgroundGallery is list;
    }

    // Recent donations database
    match /recent_donations/{donationId} {
      allow read: if true;
      allow write: if true;
    }

    // Media and recollections gallery
    match /media_gallery/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    // Sub-admins collection: only allow read for auth, allow write with complete structures
    match /sub_admins/{subAdminId} {
      allow read: if true;
      allow write: if request.resource.data.email is string && request.resource.data.password is string;
    }

    // Audit logs collection
    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if request.resource.data.actionType is string && request.resource.data.affectedRecordId is string;
    }

    // Email logs collection
    match /email_logs/{logId} {
      allow read, write: if true;
    }

    // Saved SMTP settings for secure backend fallback dispatch
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // eBook student progress tracking
    match /ebook_progress/{progressId} {
      allow read, write: if true;
    }

    // eBook highlighted content
    match /ebook_highlights/{highlightId} {
      allow read, write, delete: if true;
    }

    // eBook notes/canvas details
    match /ebook_notes/{noteId} {
      allow read, write, delete: if true;
    }

    // eBook bookmarks
    match /ebook_bookmarks/{bookmarkId} {
      allow read, write, delete: if true;
    }

    // eBook favorites
    match /ebook_favorites/{favoriteId} {
      allow read, write, delete: if true;
    }

    // eBook downloads tracking log
    match /ebook_downloads/{downloadId} {
      allow read, write: if true;
    }

    // eBook general discussions log
    match /ebook_discussions/{discussionId} {
      allow read, write: if true;
    }
  }
}
