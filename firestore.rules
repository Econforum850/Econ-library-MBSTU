rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: reject everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Books collection rules
    match /books/{bookId} {
      allow read: if true;
      allow write: if true; // Allow registered admins or dashboard writes to add products
    }

    // Members/users directory rules
    match /members/{memberId} {
      allow read, write: if true; // Allow new student/member sign-ups and authorization updates
    }

    // Donors/partners details
    match /donors/{donorId} {
      allow read: if true;
      allow write: if true;
    }

    // Issued book records
    match /issues/{issueId} {
      allow read, write: if true;
    }

    // Finances logs
    match /finances/{transactionId} {
      allow read, write: if true;
    }

    // Department events
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders checkout details
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Website graphics settings
    match /graphics/{graphicId} {
      allow read, write: if true;
    }

    // Recent donations database
    match /recent_donations/{donationId} {
      allow read, write: if true;
    }

    // Media and recollections gallery
    match /media_gallery/{mediaId} {
      allow read, write: if true;
    }
  }
}
